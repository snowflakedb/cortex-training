{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snowflakedb/cortex-training/model-catalog/schema.json",
  "title": "Cortex Training catalog model",
  "description": "model-catalog/models/<slug>/model.json. The job files beside it, <context>/<hw>-<kind>-<mode>.json, are create-job bodies; validate_catalog.py checks both.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "license",
    "architecture",
    "last_validated"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model_id": {
      "description": "Exact model ID. The folder name is its lowercased last segment.",
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "architecture": {
      "enum": [
        "dense",
        "moe"
      ]
    },
    "moe": {
      "description": "Routing geometry for router replay planning, as derived from the model config: num_hidden_layers, num_experts_per_tok, and the expert count.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num_moe_layers",
        "topk",
        "num_experts"
      ],
      "properties": {
        "num_moe_layers": {
          "type": "integer",
          "minimum": 1
        },
        "topk": {
          "type": "integer",
          "minimum": 1
        },
        "num_experts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "last_validated": {
      "description": "One entry for each job file of the model: the date of its last successful live run, or null.",
      "type": "object",
      "propertyNames": {
        "pattern": "^(standard|long)/(h200|b200|b300)-(training|inference)-(lora|full)$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "if": {
    "properties": {
      "architecture": {
        "const": "moe"
      }
    }
  },
  "then": {
    "required": [
      "moe"
    ]
  },
  "else": {
    "not": {
      "required": [
        "moe"
      ]
    }
  }
}
