{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 8,
        "max_seq_len": 262144,
        "train_batch_size": 2,
        "activation_checkpointing": true,
        "gradient_clipping": 1.0,
        "model_provider": "arctic",
        "attn_implementation": "flash_attention_3",
        "ac_config": {
          "mode": "full",
          "freq": 1,
          "core_replay": "attention",
          "combine_replay": true,
          "offload_config": {
            "enabled": true,
            "keep_last_n": 1,
            "use_streams": true,
            "pin_memory_enabled": true,
            "pin_memory_max_size_gib": "auto",
            "pin_memory_bucket_size_mib": 64
          }
        },
        "ep_size": 4,
        "model_options": {
          "lm_head": {
            "cross_entropy": false,
            "token_chunk_size": 8192
          },
          "moe": {
            "sonicmoe": true,
            "expert_replicas": 4,
            "comm_sms": 48
          }
        },
        "optimizer": {
          "name": "AdamW",
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2,
            "reduce_bucket_size": 1000000000,
            "allgather_bucket_size": 1000000000
          },
          "bf16": {
            "enabled": true
          }
        },
        "mb_spec": {
          "max_tokens_per_mb": 262144
        },
        "sp_size": 4
      }
    }
  ]
}
