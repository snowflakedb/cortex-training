{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-BF16",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 32,
