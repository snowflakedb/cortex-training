          "name": "AdamW",
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "train_batch_size": 4,
          "train_micro_batch_size_per_gpu": 1,
