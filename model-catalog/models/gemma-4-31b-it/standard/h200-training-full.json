{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "google/gemma-4-31B-it",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 4,
        "sp_size": 1,
        "max_seq_len": 65536,
        "train_batch_size": 4,
        "gradient_clipping": 1.0,
        "model_provider": "huggingface",
        "attn_implementation": "flash_attention_3",
        "activation_checkpointing": true,
        "fused_lm_head_token_chunk_size": 8192,
        "optimizer": {
          "name": "AdamW",
          "lr": 5e-06,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "train_batch_size": 4,
          "train_micro_batch_size_per_gpu": 1,
          "gradient_accumulation_steps": 1,
          "zero_optimization": {
            "stage": 2,
            "offload_optimizer": {
              "device": "cpu",
              "pin_memory": false
            }
          },
          "bf16": {
            "enabled": true
          }
        }
      }
    }
  ]
}
