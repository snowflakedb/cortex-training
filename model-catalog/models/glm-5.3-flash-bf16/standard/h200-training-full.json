{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "zai-org/GLM-5.3-Flash-BF16",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 32,
        "max_seq_len": 65536,
        "train_batch_size": 8,
        "sp_size": 8,
        "ep_size": 32,
        "gradient_clipping": 1.0,
        "model_provider": "arctic",
        "cuda_allocator_conf": "expandable_segments:True,pinned_max_round_threshold_mb:64",
        "model_options": {
          "attention": {
            "backend": "sparse_mla"
          },
          "checkpointing": {
            "mode": "full",
            "freq": 1
          },
          "lm_head": {
            "token_chunk_size": 2048,
            "cross_entropy": false
          },
          "moe": {
            "comm_token_chunk": 8192,
            "comm_backend": "uccl",
            "ultraep_spares": 2,
            "ultraep_ipc_symm": true,
            "comm_sms": 32
          }
        },
        "optimizer": {
          "name": "AdamW",
          "lr": 5e-06,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2,
            "optimizer_state_swap": {
              "fraction": 1.0,
              "stream": true,
              "group_gib": 2
            }
          },
          "bf16": {
            "enabled": true
          }
        },
        "nccl": {
          "net_plugin": "ofi",
          "tuner_plugin": "ofi"
        },
        "numa_bind": true,
        "ac_config": {
          "combine_replay": true,
          "router_replay_recompute": true
        }
      }
    }
  ]
}
