{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "inference_config": {
        "max_seq_len": 262144,
        "n_gpus": 8,
        "max_num_batched_tokens": 8192,
        "peft_config": {
          "peft_type": "Lora",
          "task_type": "CAUSAL_LM",
          "r": 16,
          "lora_alpha": 32,
          "lora_dropout": 0.0,
          "bias": "none",
          "target_modules": [
            "wq_du",
            "wv_dv"
          ],
          "target_parameters": [
            "experts.w1",
            "experts.w2",
            "experts.w3"
          ]
        },
        "router_replay": {
          "enabled": false
        },
        "vllm_config": {
          "tensor_parallel_size": 8,
          "max_num_seqs": 8,
          "gpu_memory_utilization": 0.8,
          "enable_chunked_prefill": true,
          "reasoning_parser": "inkling",
          "tool_call_parser": "inkling",
          "extra_engine_kwargs": {
            "tokenizer_mode": "inkling",
            "dtype": "bfloat16",
            "kernel_config": {
              "enable_flashinfer_autotune": false
            },
            "enforce_eager": true,
            "enable_prefix_caching": false
          }
        }
      },
      "job_type": "sampling",
      "model_name": "thinkingmachines/Inkling-2-Small-MXFP8"
    }
  ]
