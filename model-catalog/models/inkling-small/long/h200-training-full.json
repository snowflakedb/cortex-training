{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "thinkingmachines/Inkling-Small",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 32,
        "max_seq_len": 262144,
        "train_batch_size": 4,
        "gradient_clipping": 1.0,
        "model_provider": "arctic",
        "attn_implementation": "flex_attention",
        "activation_checkpointing": true,
        "ep_size": 32,
        "sp_size": 8,
        "ac_config": {
          "mode": "full",
          "freq": 1,
          "router_replay_recompute": false,
          "offload_config": {
            "enabled": true,
            "keep_last_n": 1,
            "use_streams": true,
            "pin_memory_enabled": true,
            "pin_memory_max_size_gib": "auto",
            "pin_memory_bucket_size_mib": 64
          },
          "combine_replay": false
        },
        "optimizer": {
          "name": "AdamW",
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "train_batch_size": 4,
          "train_micro_batch_size_per_gpu": 1,
          "gradient_accumulation_steps": 1,
          "zero_optimization": {
            "stage": 2,
            "reduce_bucket_size": 1000000,
            "allgather_bucket_size": 1000000,
            "overlap_comm": false
          },
          "bf16": {
            "enabled": true,
            "bf16_master_weights_and_grads": true,
            "bf16_optimizer_states": true
          },
          "data_types": {
            "grad_accum_dtype": "bf16"
          }
        },
        "router_replay": {
          "enabled": false
        },
        "prime_rl": {
          "fused_cross_entropy": false,
          "ep_comm_backend": "nccl",
          "moe_use_grouped_mm": true,
          "fused_lm_head_token_chunk_size": 512,
          "deepep_token_chunk_size": 256,
          "attention_query_chunk_size": 2048
        },
        "tiled_mlp_token_chunk_size": 1024,
        "ep_group_layout": "auto",
        "cuda_allocator_conf": "expandable_segments:True",
        "mb_spec": {
          "max_tokens_per_mb": 262144
        },
        "step_peak_memory_log": true
      }
    }
  ]
}
