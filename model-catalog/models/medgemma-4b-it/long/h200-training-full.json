        "optimizer": {
          "name": "AdamW",
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2
          },
          "bf16": {
            "enabled": true
          }
        }
      }
    }
  ]
