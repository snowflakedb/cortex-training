{
  "hardware": "H200",
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "google/medgemma-4b-it",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 8,
        "max_seq_len": 131072,
        "train_batch_size": 8,
        "gradient_clipping": 1.0,
        "model_provider": "huggingface",
        "attn_implementation": "flash_attention_3",
        "activation_checkpointing": true,
        "fused_lm_head_token_chunk_size": 8192,
        "optimizer": {
          "name": "AdamW",
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2
          },
          "bf16": {
            "enabled": true
          }
        },
        "peft_config": {
          "peft_type": "Lora",
          "r": 32,
          "lora_alpha": 32,
          "lora_dropout": 0.0,
          "bias": "none",
          "target_modules": ".*language_model.*\\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)"
        },
        "model_options": {
          "liger": true
        },
        "checkpoint_keep_attention": true
      }
    }
  ]
}
